---
import { NAV_LINKS, flattenLinks } from "@/data/navigation";
import { IS_STAGING } from "@/lib/staging";
const { currentPage = "/" } = Astro.props;
const pages = NAV_LINKS.flatMap((group) => flattenLinks(group.subitems ?? []));
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="container header-inner">
    <a
      href="/"
      class="department-brand"
      aria-label="Computer Science and Engineering, IIT Gandhinagar home"
    >
      <img
        src="/layout/iitgn-logo.webp"
        alt="IIT Gandhinagar"
        width="180"
        height="48"
        fetchpriority="high"
      />
      <span>Computer Science<br />&amp; Engineering</span>
    </a>
    <nav id="main-navigation" aria-label="Main navigation" class="site-navigation">
      {
        NAV_LINKS.map((group) => (
          <details class="nav-group" name="main-navigation">
            <summary
              class:list={{
                "current-section": currentPage.replace(/\/$/, "") === group.href || flattenLinks(group.subitems ?? []).some(
                  (item) => currentPage.startsWith(item.href),
                ),
              }}
            >
              {group.label}
              <svg class="nav-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 4.5 3 3 3-3" /></svg>
            </summary>
            <div class="nav-dropdown">
              <a class="nav-overview" href={group.href}>
                {group.label} overview
              </a>
              <div class="nav-links">
              {group.subitems?.map((item) =>
                item.children ? (
                  <div class="nav-area-group">
                    <p>{item.label}</p>
                    {item.children.map((child) => (
                      <a href={child.href} aria-current={currentPage.replace(/\/$/, "") === child.href ? "page" : undefined}>{child.label}</a>
                    ))}
                  </div>
                ) : (
                  <a href={item.href} aria-current={currentPage.replace(/\/$/, "") === item.href ? "page" : undefined}>
                    <span>{item.label}</span><small>{item.description}</small>
                  </a>
                ),
              )}
              </div>
            </div>
          </details>
        ))
      }
    </nav>
    <div class="header-actions">
      <button type="button" class="mobile-menu-toggle" data-nav-toggle aria-expanded="false" aria-controls="main-navigation" hidden>
        <span>Menu</span><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 6h14M3 14h14" /></svg>
      </button>
      <button
        type="button"
        data-search-open
        aria-label="Search site"
        title="Search (⌘K)"
        ><svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
          ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"
          ></path></svg
        ></button
      >
      <button
        type="button"
        data-mode-toggle
        aria-label="Dark mode"
        aria-pressed="false"
        title="Toggle dark mode"
        ><svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
          ><path d="M20.9 13.2A9 9 0 0 1 10.8 3.1a9 9 0 1 0 10.1 10.1Z"
          ></path></svg
        ></button
      >
    </div>
  </div>
</header>
{IS_STAGING && <div class="theme-review-bar">
  <div class="container theme-review-inner">
    <label for="palette-select"
      >Colour
      <select id="palette-select" data-appearance="q">
        <option value="navy">Navy</option><option value="forest">Forest</option
        ><option value="terracotta">Terracotta</option>
      </select>
    </label>
    <label for="typography-select"
      >Typography
      <select id="typography-select" data-appearance="type">
        <option value="modern">Modern</option><option value="system"
          >System</option
        ><option value="editorial">Editorial</option>
      </select>
    </label>
    <span class="theme-share-note">Your choices are included in the URL</span>
  </div>
</div>}
<dialog id="site-search" aria-labelledby="search-title">
  <div class="search-top">
    <h2 id="search-title">Search the site</h2><button
      type="button"
      data-search-close
      aria-label="Close search">✕</button
    >
  </div>
  <label class="sr-only" for="site-search-input"
    >Search pages and programs</label
  ><input
    id="site-search-input"
    type="search"
    placeholder="Search pages and programs…"
    autocomplete="off"
  />
  <ul>
    {
      pages.map((page) => (
        <li data-search-item>
          <a href={page.href}>
            {page.label}
            <small>{page.description}</small>
          </a>
        </li>
      ))
    }
  </ul>
  <p data-search-empty hidden>
    No matching pages. Try “faculty”, “courses”, or “seminars”.
  </p>
</dialog>
<script>
  const header = document.querySelector<HTMLElement>(".site-header")!;
  const navigation = header.querySelector<HTMLElement>(".site-navigation")!;
  const menuToggle = header.querySelector<HTMLButtonElement>("[data-nav-toggle]")!;
  const groups = [...navigation.querySelectorAll<HTMLDetailsElement>(".nav-group")];
  const closeNavigation = () => {
    groups.forEach(group => group.open = false);
    menuToggle.setAttribute("aria-expanded", "false");
    header.classList.remove("menu-open");
  };
  header.dataset.navEnhanced = "true";
  menuToggle.hidden = false;
  menuToggle.addEventListener("click", event => {
    const opening = menuToggle.getAttribute("aria-expanded") !== "true";
    closeNavigation();
    menuToggle.setAttribute("aria-expanded", String(opening));
    header.classList.toggle("menu-open", opening);
    if (opening && event.detail === 0) navigation.querySelector("summary")?.focus();
  });
  menuToggle.addEventListener("keydown", event => {
    if (event.key === "Escape") closeNavigation();
  });
  groups.forEach(group => {
    const trigger = group.querySelector<HTMLElement>("summary")!;
    trigger.addEventListener("keydown", event => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        group.open = true;
        group.querySelector<HTMLAnchorElement>("a")?.focus();
      }
    });
    group.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        if (!group.contains(document.activeElement)) group.open = false;
      });
    });
  });
  navigation.addEventListener("keydown", event => {
    if (event.key !== "Escape") return;
    event.preventDefault();
    event.stopPropagation();
    const openGroup = groups.find(group => group.open);
    if (openGroup) {
      openGroup.open = false;
      openGroup.querySelector("summary")?.focus();
    } else {
      closeNavigation();
      menuToggle.focus();
    }
  });
  document.addEventListener("click", event => {
    if (!header.contains(event.target as Node)) closeNavigation();
  });
  window.matchMedia("(max-width: 1050px)").addEventListener("change", closeNavigation);

  const dialog = document.querySelector<HTMLDialogElement>("#site-search")!;
  const input = document.querySelector<HTMLInputElement>("#site-search-input")!;
  const openSearch = () => {
    closeNavigation();
    dialog.showModal();
    input.focus();
  };
  document
    .querySelector("[data-search-open]")
    ?.addEventListener("click", openSearch);
  document
    .querySelector("[data-search-close]")
    ?.addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) {
      const r = dialog.getBoundingClientRect();
      if (
        e.clientX < r.left ||
        e.clientX > r.right ||
        e.clientY < r.top ||
        e.clientY > r.bottom
      )
        dialog.close();
    }
  });
  input.addEventListener("input", () => {
    let count = 0;
    dialog.querySelectorAll<HTMLElement>("[data-search-item]").forEach((li) => {
      li.hidden = !li.textContent
        ?.toLowerCase()
        .includes(input.value.trim().toLowerCase());
      if (!li.hidden) count++;
    });
    dialog.querySelector<HTMLElement>("[data-search-empty]")!.hidden =
      count > 0;
  });
  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openSearch();
    }
    if (e.key === "Escape")
      document
        .querySelectorAll<HTMLDetailsElement>(".nav-group[open]")
        .forEach((d) => {
          d.open = false;
          d.querySelector("summary")?.focus();
        });
  });
  document.addEventListener("click", (e) => {
    document
      .querySelectorAll<HTMLDetailsElement>(".nav-group[open]")
      .forEach((d) => {
        if (!d.contains(e.target as Node)) d.open = false;
      });
  });
</script>
