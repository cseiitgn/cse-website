---
import { NAV_LINKS } from "@/data/navigation";
const { currentPage = "/" } = Astro.props;
const pages = NAV_LINKS.flatMap((group) => group.subitems ?? []);
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="container header-inner">
    <a
      href="/"
      class="department-brand"
      aria-label="Computer Science and Engineering, IIT Gandhinagar home"
    >
      <img
        src="/layout/iitgn-logo.webp"
        alt="IIT Gandhinagar"
        width="180"
        height="48"
        fetchpriority="high"
      />
      <span>Computer Science<br />&amp; Engineering</span>
    </a>
    <nav aria-label="Main navigation" class="site-navigation">
      {
        NAV_LINKS.map((group) => (
          <details class="nav-group" name="main-navigation">
            <summary
              class:list={{
                "current-section": group.subitems?.some((item) =>
                  currentPage.startsWith(item.href),
                ),
              }}
            >
              {group.label}
              <span aria-hidden="true">⌄</span>
            </summary>
            <div class="nav-dropdown">
              {group.subitems?.map((item) => (
                <a
                  href={item.href}
                  aria-current={
                    currentPage.replace(/\/$/, "") === item.href
                      ? "page"
                      : undefined
                  }
                >
                  {item.label}
                  <small>{item.description}</small>
                </a>
              ))}
            </div>
          </details>
        ))
      }
    </nav>
    <div class="header-actions">
      <button
        type="button"
        data-search-open
        aria-label="Search site"
        title="Search (⌘K)"
        ><svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
          ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"
          ></path></svg
        ></button
      >
      <button
        type="button"
        data-mode-toggle
        aria-label="Dark mode"
        aria-pressed="false"
        title="Toggle dark mode"
        ><svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
          ><path d="M20.9 13.2A9 9 0 0 1 10.8 3.1a9 9 0 1 0 10.1 10.1Z"
          ></path></svg
        ></button
      >
    </div>
  </div>
</header>
<div class="theme-review-bar">
  <div class="container theme-review-inner">
    <span>Explore a colour theme</span><nav aria-label="Colour themes">
      <a href="?q=navy" data-palette-choice="navy"
        ><i style="background:#244665" aria-hidden="true"></i>Navy</a
      ><a href="?q=forest" data-palette-choice="forest"
        ><i style="background:#28604f" aria-hidden="true"></i>Forest</a
      ><a href="?q=terracotta" data-palette-choice="terracotta"
        ><i style="background:#934a32" aria-hidden="true"></i>Terracotta</a>
    </nav><span class="theme-share-note"
      >Share the URL to share your theme</span>
  </div>
</div>
<dialog id="site-search" aria-labelledby="search-title">
  <div class="search-top">
    <h2 id="search-title">Search the site</h2><button
      type="button"
      data-search-close
      aria-label="Close search">✕</button>
  </div>
  <label class="sr-only" for="site-search-input"
    >Search pages and programs</label
  ><input
    id="site-search-input"
    type="search"
    placeholder="Search pages and programs…"
    autocomplete="off"
  />
  <ul>
    {
      pages.map((page) => (
        <li data-search-item>
          <a href={page.href}>
            {page.label}
            <small>{page.description}</small>
          </a>
        </li>
      ))
    }
  </ul>
  <p data-search-empty hidden>
    No matching pages. Try “faculty”, “courses”, or “seminars”.
  </p>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>("#site-search")!;
  const input = document.querySelector<HTMLInputElement>("#site-search-input")!;
  const openSearch = () => {
    dialog.showModal();
    input.focus();
  };
  document
    .querySelector("[data-search-open]")
    ?.addEventListener("click", openSearch);
  document
    .querySelector("[data-search-close]")
    ?.addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) {
      const r = dialog.getBoundingClientRect();
      if (
        e.clientX < r.left ||
        e.clientX > r.right ||
        e.clientY < r.top ||
        e.clientY > r.bottom
      )
        dialog.close();
    }
  });
  input.addEventListener("input", () => {
    let count = 0;
    dialog.querySelectorAll<HTMLElement>("[data-search-item]").forEach((li) => {
      li.hidden = !li.textContent
        ?.toLowerCase()
        .includes(input.value.trim().toLowerCase());
      if (!li.hidden) count++;
    });
    dialog.querySelector<HTMLElement>("[data-search-empty]")!.hidden =
      count > 0;
  });
  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openSearch();
    }
    if (e.key === "Escape")
      document
        .querySelectorAll<HTMLDetailsElement>(".nav-group[open]")
        .forEach((d) => {
          d.open = false;
          d.querySelector("summary")?.focus();
        });
  });
  document.addEventListener("click", (e) => {
    document
      .querySelectorAll<HTMLDetailsElement>(".nav-group[open]")
      .forEach((d) => {
        if (!d.contains(e.target as Node)) d.open = false;
      });
  });
</script>
