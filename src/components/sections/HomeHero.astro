<section class="home-hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Indian Institute of Technology Gandhinagar</p><h1>
        Computer Science<br />&amp; Engineering
      </h1><p class="hero-description">
        We teach and study computer science at IIT Gandhinagar, from algorithms and computer systems to artificial intelligence.
      </p><div class="hero-actions">
        <a class="primary-link" href="/research"
          >Explore our research</a
        ><a class="text-link" href="/people/faculty"
          >Meet our faculty</a>
      </div><a class="careers-link" href="/about/careers"
        >Join us at IIT Gandhinagar</a>
    </div>
    <figure class="hero-photo" data-community-gallery aria-label="CSE community photographs" aria-roledescription="carousel">
      <a href="/images/people/cse-class-2026-1440.webp" aria-label="View photograph at full size" target="_blank" rel="noreferrer">
      <img
        src="/images/people/cse-class-2026-960.webp"
        srcset="/images/people/cse-class-2026-640.webp 640w, /images/people/cse-class-2026-960.webp 960w, /images/people/cse-class-2026-1440.webp 1440w"
        sizes="(min-width: 901px) 460px, calc(100vw - 60px)"
        alt="CSE students from the Class of 2026 with faculty in the auditorium"
        width="960"
        height="540"
        fetchpriority="high"
        decoding="async"
      /></a><figcaption>
        <span data-photo-caption>CSE · Class of 2026</span>
        <div class="photo-controls" hidden>
          <button type="button" data-photo-index="0" aria-label="Show Class of 2026 photograph" aria-pressed="true">Class of 2026</button>
          <button type="button" data-photo-index="1" aria-label="Show farewell dinner photograph" aria-pressed="false">Farewell dinner</button>
        </div>
      </figcaption>
      <span class="sr-only" data-photo-status role="status"></span>
    </figure>
  </div>
</section>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-community-gallery]')!;
  const image = gallery.querySelector<HTMLImageElement>('img')!;
  const link = gallery.querySelector<HTMLAnchorElement>('a')!;
  const caption = gallery.querySelector<HTMLElement>('[data-photo-caption]')!;
  const controls = gallery.querySelector<HTMLElement>('.photo-controls')!;
  const status = gallery.querySelector<HTMLElement>('[data-photo-status]')!;
  const buttons = [...controls.querySelectorAll<HTMLButtonElement>('button')];
  const photos = [
    {name:'cse-class-2026', caption:'CSE · Class of 2026', alt:image.alt},
    {name:'cse-farewell-dinner', caption:'CSE farewell dinner', alt:'CSE students and faculty together at the farewell dinner, with a seated front row and colleagues standing behind'},
  ];
  let current = 0;
  let loading = false;
  controls.hidden = false;
  caption.hidden = true;
  async function showPhoto(nextIndex:number) {
    if (loading || nextIndex === current) return;
    loading = true;
    buttons.forEach(button => button.setAttribute('aria-disabled','true'));
    status.textContent = 'Loading photograph';
    const photo = photos[nextIndex];
    const base = `/images/people/${photo.name}`;
    const next = new Image();
    next.sizes = image.sizes;
    next.srcset = [640,960,1440].map(width => `${base}-${width}.webp ${width}w`).join(', ');
    next.src = `${base}-960.webp`;
    try {
      await next.decode();
      image.srcset = next.srcset;
      image.src = next.src;
      image.alt = photo.alt;
      link.href = `${base}-1440.webp`;
      caption.textContent = photo.caption;
      current = nextIndex;
      buttons.forEach((button,index) => button.setAttribute('aria-pressed',String(index === current)));
      status.textContent = photo.caption;
    } catch {
      status.textContent = 'Photograph could not load. Please try again.';
    } finally {
      loading = false;
      buttons.forEach(button => button.removeAttribute('aria-disabled'));
    }
  }
  buttons.forEach(button => button.addEventListener('click', () => showPhoto(Number(button.dataset.photoIndex))));
  controls.addEventListener('keydown', event => {
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
      event.preventDefault();
      const nextIndex = (current + (event.key === 'ArrowLeft' ? -1 : 1) + photos.length) % photos.length;
      buttons[nextIndex].focus();
      showPhoto(nextIndex);
    }
  });
</script>
