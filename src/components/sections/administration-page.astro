---
import { COMMITTEE_GROUPS, DFAC } from "@/data/administration";
---

<section class="section-padding administration-page">
  <div class="container">
    <div class="administration-intro">
      <div>
        <p class="eyebrow">Department</p>
        <h1>Administration</h1>
        <p class="page-lead">
          Find the faculty responsible for admissions, academic records,
          examinations, and department activities.
        </p>
        <p class="source-note">
          Committee term: <strong>1 September 2026–31 August 2027</strong>
        </p>
      </div>
      <aside class="head-contact">
        <img
          src="/images/faculty/shanmuganathan-raman.webp"
          alt="Shanmuganathan Raman"
          width="96"
          height="112"
        />
        <div>
          <p class="eyebrow">Head of Department</p><h2>
            <a href="https://iitgn.ac.in/faculty/ee/fac-shanmuganathan"
              >Shanmuganathan Raman</a>
          </h2><a href="mailto:hod.cse@iitgn.ac.in">hod.cse@iitgn.ac.in</a>
        </div>
      </aside>
    </div>
    <nav class="section-jump-links" aria-label="Administration sections">
      {
        COMMITTEE_GROUPS.map((group) => (
          <a href={`#${group.id}`}>{group.title}</a>
        ))
      }
      <a href="#faculty-affairs">Faculty Affairs Committee</a>
    </nav>
    <label class="admin-search-label" for="admin-search"
      >Find a responsibility or person</label
    >
    <input
      id="admin-search"
      type="search"
      placeholder="e.g. admissions, website, or a faculty name"
      autocomplete="off"
    />
    <p id="admin-no-results" role="status" hidden>
      No matching responsibilities. Try a faculty surname or contact the
      department office.
    </p>
    {
      COMMITTEE_GROUPS.map((group) => (
        <section id={group.id} class="admin-group" data-admin-group>
          <h2>{group.title}</h2>
          <dl class="admin-roles">
            {group.roles.map((role) => (
              <div class="admin-role" data-admin-role>
                <dt>
                  {role.title}
                  {"note" in role && <small>{role.note}</small>}
                </dt>
                <dd>{role.members.join(", ")}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }
    <section id="faculty-affairs" class="admin-group" data-admin-group>
      <h2>Departmental Faculty Affairs Committee (DFAC)</h2>
      <p class="source-note">
        Serving since <strong>10 September 2026</strong>.
      </p>
      <dl class="admin-roles">
        {
          DFAC.map((member) => (
            <div class="admin-role" data-admin-role>
              <>
                <dt>{member.role}</dt>
                <dd>{member.name}</dd>
              </>
            </div>
          ))
        }
      </dl>
    </section>
    <p class="admin-office">
      For general enquiries, contact <a href="mailto:office.cse@iitgn.ac.in"
        >office.cse@iitgn.ac.in</a
      > or see the <a href="/people/staff">staff directory</a>.
    </p>
  </div>
</section>
<script>
  const input = document.querySelector<HTMLInputElement>("#admin-search")!;
  const filterRoles = () => {
    const query = input.value.trim().toLowerCase();
    let matches = 0;
    document
      .querySelectorAll<HTMLElement>("[data-admin-group]")
      .forEach((group) => {
        let visible = 0;
        group
          .querySelectorAll<HTMLElement>("[data-admin-role]")
          .forEach((row) => {
            row.hidden =
              !`${group.querySelector("h2")?.textContent} ${row.textContent}`
                .toLowerCase()
                .includes(query);
            if (!row.hidden) visible++;
          });
        group.hidden = !visible;
        matches += visible;
      });
    document.querySelector<HTMLElement>("#admin-no-results")!.hidden =
      matches > 0;
  };
  input.addEventListener("input", filterRoles);
  document.querySelectorAll(".section-jump-links a").forEach((link) =>
    link.addEventListener("click", () => {
      input.value = "";
      filterRoles();
    }),
  );
</script>
