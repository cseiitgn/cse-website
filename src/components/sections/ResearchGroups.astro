---
import { RESEARCH_GROUPS, UNALLOCATED_FACULTY } from "@/data/research-groups";
const { compact = false } = Astro.props;
---

<section class="section-padding research-groups">
  <div class="container">
    <div class="research-intro">
      <div>
        <p class="eyebrow">Research at CSE</p>{
          compact ? <h2>Research areas</h2> : <h1>Research</h1>
        }
      </div>
      <p>
        Find faculty, topics, and selected work in each area. Many faculty work
        across these areas.
      </p>
    </div>
    {
      RESEARCH_GROUPS.map((group, index) => (
        <article class="research-row">
          <span class="research-number">0{index + 1}</span>
          <div class="research-summary">
            <h2>
              <a href={`/research/${group.slug}`}>
                {group.title} <span aria-hidden="true">↗</span>
              </a>
            </h2>
            <p>{group.description}</p>
          </div>
          <a
            class="text-link research-area-link"
            href={`/research/${group.slug}`}
          >
            Faculty and research <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
    {
      !compact && (
        <p class="mt-7 text-sm text-muted-foreground">
          Browse{" "}
          <a class="underline" href="/research/publications">
            publications
          </a>
          ,{" "}
          <a class="underline" href="/research/projects">
            funded projects
          </a>
          , or{" "}
          <a class="underline" href="/research/patents">
            patents
          </a>{" "}
          across the department.
        </p>
      )
    }
    {!compact && UNALLOCATED_FACULTY.length > 0 && (
      <section id="unallocated" class="mt-12 border-t pt-8" aria-labelledby="unallocated-heading">
        <h2 id="unallocated-heading" class="text-xl font-semibold">Unallocated faculty</h2>
        <p class="mt-3 text-muted-foreground">These faculty remain in the directory and do not currently have an area allocation.</p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2" data-unallocated-faculty>
          {UNALLOCATED_FACULTY.map(member => (
            <li><a class="underline underline-offset-4" href={member.homepage ?? member.links?.find(link => link.type === 'website')?.url ?? '/people/faculty'}>{member.name}</a></li>
          ))}
        </ul>
        <p class="mt-5"><a class="text-link" href="/people/faculty">View all faculty</a></p>
      </section>
    )}
  </div>
</section>
