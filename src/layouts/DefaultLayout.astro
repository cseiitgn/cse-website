---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/SiteFooter.astro";
import Navbar from "@/components/layout/SiteHeader.astro";

const { title, description, image, imageAlt } = Astro.props;
const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
    />
  </head>
  <body class="min-h-dvh antialiased flex flex-col">
    <Navbar currentPage={currentPath} />
    <main class="flex-1" id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
