---
import ResearchAreaProfile from "@/components/sections/research-area-profile.astro";
import { RESEARCH_GROUPS } from "@/data/research-groups";
import DefaultLayout from "@/layouts/DefaultLayout.astro";

const area = RESEARCH_GROUPS.find((group) => group.slug === "ai")!.area;
---

<DefaultLayout
  title="AI & Machine Learning"
  description="Deep learning, NLP, computer vision, and AI for social good."
>
  <ResearchAreaProfile area={area} />
</DefaultLayout>
