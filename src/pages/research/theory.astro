---
import ResearchAreaProfile from "@/components/sections/research-area-profile.astro";
import { RESEARCH_GROUPS } from "@/data/research-groups";
import DefaultLayout from "@/layouts/DefaultLayout.astro";

const area = RESEARCH_GROUPS.find((group) => group.slug === "theory")!.area;
---

<DefaultLayout
  title="Theoretical CS"
  description="Algorithms, computational complexity, and graph theory."
>
  <ResearchAreaProfile area={area} />
</DefaultLayout>
