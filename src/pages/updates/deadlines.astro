---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
const deadline = "2026-09-15T23:00:00+05:30";
const closed = Date.now() > new Date(deadline).getTime();
---

<DefaultLayout
  title="Deadlines"
  description="Application and nomination deadlines relevant to CSE students and researchers."
>
  <section class="section-padding section-overview">
    <div class="container">
      <p class="eyebrow">News &amp; events</p><h1>Deadlines</h1>
      <p class="page-lead">
        Check the organiser’s announcement before applying. Degree admissions
        dates and requirements are maintained on <a
          class="underline"
          href="https://iitgn.ac.in/admissions">IITGN’s admissions website</a
        >.
      </p>
      <article class="deadline-entry" data-deadline={deadline}>
        <p class="eyebrow">
          Nomination deadline · <time datetime={deadline}
            >15 September 2026, 11 pm IST</time>
        </p>
        <h2>ACM India Doctoral Dissertation Award 2026</h2>
        <p>
          For dissertations defended between 1 July 2025 and 30 June 2026.
          Nominations are submitted by the primary advisor with institutional
          endorsement; students should contact their advisor and the department
          office.
        </p>
        <p data-deadline-status>
          {
            closed
              ? "Nomination deadline passed"
              : "Nominations close on 15 September"
          }
        </p>
        <a
          class="text-link"
          href="https://cmt3.research.microsoft.com/acmindiaawards2026"
          >Award submission portal →</a
        >
      </article>
      <section class="admin-group">
        <h2>Past deadlines</h2><p class="text-muted-foreground">
          Theory Day 2026 registration closed on 14 June 2026. <a
            class="underline"
            href="/events/theory-day-2026">View the event archive</a
          >.
        </p>
      </section>
    </div>
  </section>
</DefaultLayout>
<script>
  // Keep status correct between static builds, including pages left open overnight.
  const update = () =>
    document
      .querySelectorAll<HTMLElement>("[data-deadline]")
      .forEach((entry) => {
        if (Date.now() > new Date(entry.dataset.deadline!).getTime())
          entry.querySelector<HTMLElement>(
            "[data-deadline-status]",
          )!.textContent = "Nomination deadline passed";
      });
  update();
  setInterval(update, 60000);
</script>
<style>
  .deadline-entry {
    margin-top: 2.5rem;
    padding: 1.5rem 0;
    border-block: 1px solid var(--border);
    max-width: 800px;
  }
  .deadline-entry h2 {
    font-size: 1.6rem;
    margin: 1rem 0;
  }
  .deadline-entry > p {
    line-height: 1.7;
  }
  [data-deadline-status] {
    margin: 1rem 0;
    font-size: 0.85rem;
    font-weight: 500;
  }
</style>
