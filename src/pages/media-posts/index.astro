---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { MEDIA_POSTS, mediaAsset } from '@/data/media-posts';
import '@/styles/media-posts.css';
---
<DefaultLayout title="Media posts" description="CSE announcements, posters and captions for sharing.">
  <section class="container media-page">
    <header class="media-heading">
      <p class="media-eyebrow">CSE at IIT Gandhinagar</p>
      <h1>Media posts</h1>
      <p>Posters and captions for department announcements.</p>
      <a class="media-link" href="/awards/">Awards &amp; fellowships →</a>
    </header>
    <div class="media-list">
      {MEDIA_POSTS.map(post => (
        <article class="media-entry">
          <a class="media-cover" href={`/media-posts/${post.slug}/`} aria-label={`View posters: ${post.title}`}>
            <img src={mediaAsset(post.slug, 'simple-preview', 'webp')} alt={post.title} width="1080" height="1350" loading="lazy" />
          </a>
          <div class="media-entry-copy">
            <time datetime={post.date}>{post.displayDate}</time>
            <h2><a href={`/media-posts/${post.slug}/`}>{post.title}</a></h2>
            <p>{post.summary}</p>
            <a class="media-link" href={`/media-posts/${post.slug}/`}>View posters &amp; caption →</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</DefaultLayout>
